# Copy to .env.dev for `task run`. Real deployment values live only on the server.
VAXBOOK_ENV=dev
VAXBOOK_HTTP_ADDR=:8080
# compose.dev.yaml publishes Postgres on VAXBOOK_DEV_DB_PORT (default 5432).
VAXBOOK_DEV_DB_PORT=5432
VAXBOOK_DATABASE_URL=postgres://vaxbook:vaxbook@127.0.0.1:5432/vaxbook?sslmode=disable
# Host of the user app, without scheme or port. Requests for other hosts get 404.
VAXBOOK_APP_HOST=localhost
# HMAC key for stored OTP hashes, at least 32 bytes. Generate: openssl rand -base64 48
VAXBOOK_OTP_PEPPER=change-me-change-me-change-me-change-me
# console prints sign-in codes to the log; allowed only with VAXBOOK_ENV=dev.
VAXBOOK_MAILER=console
VAXBOOK_LOG_LEVEL=debug
