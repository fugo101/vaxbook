{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VaxBook rule set snapshot and engine contract",
  "description": "Go structs in ruleset/ and engine/ are the source (SAD §3). This schema checks shape. null is never valid; an optional member is omitted; members added after S1 are optional. Content checks live in ruleset.Validate and engine.Validate. They include the keywords the Go decoders do not enforce (enums, minLength, minItems, uniqueItems, the Id pattern). The Input schema accepts every Input that Evaluate assesses, so ⚪ INVALID_DATE (A9) stays reachable for a client that validates against it. The root is a rule set snapshot; $defs Input and Output are the engine's input and output (engine slice S1 subset).",
  "$ref": "#/$defs/Snapshot",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "Span": {
      "description": "An age, interval, offset or buffer as an ISO 8601 duration with one designator: P<n>D days, P<n>W weeks (7 days), P<n>M months (day of month clamped to the month end), P<n>Y years (12 months); n in 0..999, no leading zeros, upper case. Compound durations are not accepted yet.",
      "type": "string",
      "pattern": "^P(0|[1-9][0-9]{0,2})[DWMY]$",
      "format": "duration"
    },
    "Date": {
      "description": "A civil date YYYY-MM-DD from 0001-01-01 to 9999-12-31 that exists in the proleptic Gregorian calendar. The pattern alone checks this, leap years included, so a validator that treats format as an annotation (the draft 2020-12 default) accepts exactly what the engine decodes.",
      "type": "string",
      "pattern": "^(([0-9]{3}[1-9]|[0-9]{2}[1-9]0|[0-9][1-9]00|[1-9]000)-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)$",
      "format": "date"
    },
    "Snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "diseases", "series"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "illustrative": {"description": "A fixture or demo rule set, not medically verified; the publish path never sets it.", "type": "boolean"},
        "diseases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Disease"}},
        "series": {"type": "array", "items": {"$ref": "#/$defs/Series"}}
      }
    },
    "Disease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"$ref": "#/$defs/Id"},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "Series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "disease", "stage", "plans"],
      "properties": {
        "id": {"$ref": "#/$defs/Id"},
        "disease": {"$ref": "#/$defs/Id"},
        "stage": {"enum": ["childhood", "adult"]},
        "plans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Plan"}}
      }
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "doses"],
      "properties": {
        "id": {"$ref": "#/$defs/Id"},
        "doses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/DoseRule"}}
      }
    },
    "DoseRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended"],
      "properties": {
        "minAge": {"$ref": "#/$defs/Span"},
        "minInterval": {"$ref": "#/$defs/Span"},
        "recommended": {"$ref": "#/$defs/Milestone"},
        "buffer": {"$ref": "#/$defs/Span"}
      }
    },
    "Milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "offset"],
      "properties": {
        "from": {"enum": ["birth", "firstDose", "previousDose"]},
        "offset": {"$ref": "#/$defs/Span"}
      }
    },
    "Input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["today", "profile", "doses"],
      "properties": {
        "today": {"$ref": "#/$defs/Date"},
        "profile": {"$ref": "#/$defs/Profile"},
        "doses": {"type": "array", "items": {"$ref": "#/$defs/DoseRecord"}}
      }
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["birth"],
      "properties": {
        "birth": {"$ref": "#/$defs/RecalledDate"}
      }
    },
    "RecalledDate": {
      "description": "A date as the user remembers it (GLOSSARY: Recalled date).",
      "type": "object",
      "additionalProperties": false,
      "required": ["precision"],
      "properties": {
        "value": {
          "description": "YYYY-MM-DD for precision day; YYYY-MM and YYYY arrive with month and year in S2. Any string is accepted; engine.Validate reports one that does not parse as INVALID_DATE (⚪ on a dose record, input error on the birth date).",
          "type": "string"
        },
        "precision": {"enum": ["day", "month", "year", "unknown", "none"]}
      }
    },
    "DoseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "diseases", "date"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "diseases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}},
        "date": {"$ref": "#/$defs/RecalledDate"}
      }
    },
    "Output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleSetVersion", "today", "assessments"],
      "properties": {
        "ruleSetVersion": {"type": "string", "minLength": 1},
        "today": {"$ref": "#/$defs/Date"},
        "assessments": {"type": "array", "items": {"$ref": "#/$defs/Assessment"}}
      }
    },
    "Assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disease"],
      "oneOf": [
        {"required": ["bucket"]},
        {"required": ["block"]}
      ],
      "if": {"required": ["bucket"], "properties": {"bucket": {"const": "unknown"}}},
      "then": {"not": {"required": ["nextDose"]}},
      "properties": {
        "disease": {"$ref": "#/$defs/Id"},
        "bucket": {"enum": ["overdue", "due", "upcoming", "unknown", "complete"]},
        "block": {"enum": ["notYetScheduled"]},
        "nextDose": {"$ref": "#/$defs/NextDose"},
        "reasons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Reason"}}
      }
    },
    "NextDose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "earliest", "due", "overdue"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "earliest": {"$ref": "#/$defs/Date"},
        "due": {"$ref": "#/$defs/Date"},
        "overdue": {"$ref": "#/$defs/Date"}
      }
    },
    "Reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"enum": ["INVALID_DATE", "DOSE_INVALID", "ALTERNATIVE_PLANS", "COMPLETE", "ON_TRACK"]},
        "params": {"$ref": "#/$defs/ReasonParams"}
      }
    },
    "ReasonParams": {
      "description": "Every reason parameter; each code uses the members SAD §5.4 lists for it. Typed: IDs and enums are strings, counts are integers, lists are arrays; no booleans. Members are added additively.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["minAge", "minInterval"]}},
        "dose": {"type": "string", "minLength": 1},
        "number": {"type": "integer", "minimum": 1},
        "series": {"$ref": "#/$defs/Id"}
      }
    }
  }
}
